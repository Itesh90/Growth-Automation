# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# Anthropic Configuration (Fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Gemini Configuration (Google)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/headline_optimizer
SQLITE_URL=sqlite:///./headline_optimizer.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=86400

# Application Configuration
APP_NAME=Ad Headline Optimizer
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_BURST=10

# Model Configuration
MODEL_PATH=./models/ctr_model.pkl
FEATURE_CACHE_TTL=3600

# A/B Testing Configuration
DEFAULT_IMPRESSIONS=10000
SIGNIFICANCE_LEVEL=0.05
MIN_SAMPLE_SIZE=1000

# Cost Tracking
COST_PER_TOKEN_OPENAI=0.00003
COST_PER_TOKEN_ANTHROPIC=0.000015
MAX_COST_PER_REQUEST=0.10
