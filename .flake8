[flake8]
max-line-length = 127
max-complexity = 10
ignore = 
    E203,  # whitespace before ':'
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator
    F401,  # imported but unused (common in __init__.py)
    F403,  # star import used (common in __init__.py)
    F405,  # name may be undefined (common in __init__.py)
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .coverage,
    htmlcov,
    .venv,
    venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .mypy_cache,
    .tox
per-file-ignores =
    __init__.py:F401,F403,F405
    tests/*:S101,S106
